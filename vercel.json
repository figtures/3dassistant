{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "printflow-bridge",
          "format": "url",
          "env": "PRINTFLOW_BRIDGE_SERVICE_URL"
        }
      ]
    },
    "printflow-bridge": {
      "root": "apps/printflow-bridge/cloud",
      "runtime": "go",
      "framework": "go",
      "entrypoint": "main.go"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/overdue-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/cloud-printer-sync",
      "schedule": "*/2 * * * *"
    }
  ]
}
