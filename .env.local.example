# Supabase - https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CLI migration push (https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=your-access-token

# Opsiyonel: seed / psql (Settings → Database → Connection string, direct)
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Cron / admin API (Settings → API → service_role) — production hatırlatmalar için zorunlu
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron güvenliği (rastgele uzun string) — /api/cron/* için Authorization: Bearer
# CRON_SECRET=your-random-cron-secret

# --- Aşağıdakiler yalnızca PrintFlow işletmecisinin deploy'u içindir; müşteriler görmez (docs/saas.md) ---

# Paddle Billing (Sandbox ile başlayın)
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_STARTER_PRICE_ID=pri_...
# PADDLE_PRO_PRICE_ID=pri_...
# PADDLE_FARM_PRICE_ID=pri_...
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENV=sandbox

# Yazıcı hesap jetonlarını şifreleme (production zorunlu, min 32 karakter)
# INTEGRATION_ENCRYPTION_KEY=change-me-to-a-long-random-secret-key

# Yerel demo (sadece NODE_ENV=development + mock bulut cihazları / OAuth)
# PRINTER_CLOUD_MOCK=true

# Bambu Lab OAuth — partner onayı gelince (yoksa müşteri hesap girişi kullanır)
# BAMBU_OAUTH_CLIENT_ID=
# BAMBU_OAUTH_CLIENT_SECRET=
# BAMBU_OAUTH_AUTHORIZE_URL=https://bambulab.com/api/v1/oauth/authorize
# BAMBU_OAUTH_TOKEN_URL=https://bambulab.com/api/v1/oauth/token
# BAMBU_OAUTH_SCOPE=

# Creality OAuth — resmi ortaklık gelince (yoksa hesap girişi)
# CREALITY_OAUTH_CLIENT_ID=
# CREALITY_OAUTH_AUTHORIZE_URL=
# CREALITY_OAUTH_TOKEN_URL=
# CREALITY_OAUTH_CLIENT_SECRET=
# CREALITY_OAUTH_SCOPE=
# CREALITY_LOGIN_API_BASE=https://model-admin2.creality.com
# CREALITY_API_BASE=https://api.crealitycloud.com

# Resend e-posta (https://resend.com/api-keys)
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=PrintFlow <noreply@yourdomain.com>

# Destek / sorun bildirimi
# SUPPORT_EMAIL_TO=info@3dyanimda.com
# SUPPORT_EMAIL_FROM=PrintFlow Destek <destek@yourdomain.com>
# SUPPORT_ADMIN_EMAILS=you@company.com,teammate@company.com

# Opsiyonel: harici Sentry (tanımlı değilse yerleşik client_error_events kullanılır)
# SENTRY_DSN=

# Production site URL (Vercel deploy sonrası)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# PrintFlow Bridge installer CDN (müşteri indirmeleri)
# NEXT_PUBLIC_PRINTFLOW_BRIDGE_BASE_URL=https://cdn.3dyanimda.com/bridge/releases
# NEXT_PUBLIC_PRINTFLOW_BRIDGE_VERSION=0.1.0

# Prod migration / provision (yerel CLI — repoya şifre yazmayın)
# PRODUCTION_DATABASE_URL=postgresql://postgres:...@db....supabase.co:5432/postgres

# Opsiyonel: sesli not LLM ayrıştırma (OpenAI uyumlu API)
# OPENAI_API_KEY=sk-...
# VOICE_LLM_API_KEY=sk-...          # OPENAI yerine alternatif anahtar
# VOICE_LLM_BASE_URL=https://api.openai.com/v1
# VOICE_LLM_MODEL=gpt-4o-mini

# E2E testleri (Playwright — repoya commit etmeyin)
# E2E_EMAIL=dev.busraaktas@gmail.com
# E2E_PASSWORD=your-dev-password
